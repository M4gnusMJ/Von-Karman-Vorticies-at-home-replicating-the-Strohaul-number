# Same idea as read.csv(), but from readr (part of tidyverse)
df <- read_delim(
"med_hand_jamt_drag_middels_hastighet_2.csv",
delim = ";",
locale = locale(decimal_mark = ","),
skip=1
)
#Quick cleaning
df <- df %>% select(-...5)
df <- df %>%
mutate(across(
everything(),
~ parse_double(str_replace(.x, ",(?=\\d)", "."), na = c("", "NA")),
.names = "{.col}"
))
View(df)
