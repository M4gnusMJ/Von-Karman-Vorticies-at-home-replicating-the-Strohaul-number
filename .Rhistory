# Same idea as read.csv(), but from readr (part of tidyverse)
df <- read_delim(
"med_hand_jamt_drag_middels_hastighet_2.csv",
delim = ";",
locale = locale(decimal_mark = ","),
skip=1
)
#Quick cleaning
df <- df %>% select(-...5)
df <- df %>%
mutate(across(
everything(),
~ str_remove_all(.x, "[\\p{C}]") %>%                  # drop control characters
str_replace_all(",", ".") %>%                     # normalize decimals
str_squish()                                      # trim stray whitespace
))
df <- df %>%
mutate(across(
everything(),
~ parse_double(.x, na = c("", "NA")),
.names = "{.col}"
))
View(df)
View(df)
# Same idea as read.csv(), but from readr (part of tidyverse)
df <- read_delim(
"med_hand_jamt_drag_middels_hastighet_2.csv",
delim = ";",
skip = 1,
col_types = cols(.default = col_character()),
trim_ws = TRUE
)
# drop empty extra column if present
df <- df %>% select(-any_of("...5"))
# 1) repair broken minus signs and decimal mark
fix_tracker_num <- function(x) {
x %>%
str_replace_all("\u2212", "-") %>%          # unicode minus
str_replace_all("b[\\p{C}]*", "-") %>%      # corrupted minus from export
str_replace_all("[\\p{C}]", "") %>%         # remaining control chars
str_replace_all(",", ".") %>%               # decimal comma -> dot
str_squish()
}
df_clean <- df %>%
mutate(across(everything(), fix_tracker_num))
# 2) parse to double
df_num <- df_clean %>%
mutate(across(everything(), ~ parse_double(.x, na = c("", "NA"))))
# use numeric dataframe
df <- df_num
# quick check
df %>% summarise(across(everything(), ~ sum(is.na(.))))
View(df)
View(df)
View(df_clean)
View(df_clean)
View(df_num)
View(df_num)
View(df)
View(df)
# Similar to head(), dim(), str()
df %>% glimpse()
df %>% slice_head(n = 6)
df %>% summarise(rows = n(), cols = ncol(df))
mean(df$v, na.rm = T)
mean(df$v, na.rm = T)
sd(df$v, na.rm= T)
